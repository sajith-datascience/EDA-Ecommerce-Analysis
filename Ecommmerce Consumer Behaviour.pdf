  {
   "cell_type": "markdown",
   "id": "f29ae9fd-6d96-44aa-9d77-33515f1db2b8",
   "metadata": {},
   "source": [
    "## 13. Keep Transactions seperate like morning , afernoon, evening , night "
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 25,
   "id": "80904a21-2a65-4eda-aa26-2d840a568f7d",
   "metadata": {},
   "outputs": [],
   "source": [
    "def order_time(x):\n",
    "    if x in [6,7,8,9,10,11,12]:\n",
    "        return 'Morning'\n",
    "    if x in [13,14,15,16,17]:\n",
    "        return 'Afternoon'\n",
    "    if x in [18,19,20,21,22]:\n",
    "        return 'Evening'\n",
    "    if x in [23,24,0,1,2,3,4,5]:\n",
    "        return 'Night'\n",
    "    return x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 26,
   "id": "59d0568c-78b2-4b16-a965-b592a55c212e",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"order_time_list\"]=df[\"order_hour_of_day\"].apply(order_time)"
   ]
  },
