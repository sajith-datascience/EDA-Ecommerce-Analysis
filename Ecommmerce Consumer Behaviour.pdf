  {
   "cell_type": "code",
   "execution_count": 36,
   "id": "32d7555d-9cc7-44be-b605-64f27b8f7995",
   "metadata": {},
   "outputs": [],
   "source": [
    "def order_number_group(x):\n",
    "    if x <= 20 :\n",
    "        x= '1-20 orders'\n",
    "    elif x >20 and x <=40:\n",
    "        x= '21-40 orders'\n",
    "    elif x >40 and x <=60:\n",
    "        x= '41-60 orders'\n",
    "    elif x >60 and x <=80:\n",
    "        x= '61-80 orders'\n",
    "    else:\n",
    "        x= '81-100 orders'\n",
    "    return x"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 37,
   "id": "5d50baca-e48e-4cb1-acca-bed00ca6ed6a",
   "metadata": {},
   "outputs": [],
   "source": [
    "df[\"order_number_group\"]=df[\"order_number\"].apply(order_number_group)"
   ]
  },
